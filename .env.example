# Otobo instance base URL (without trailing slash)
OTOBO_BASE_URL=https://otobo.example.com

# Agent credentials for API access
OTOBO_USERNAME=agent-username
OTOBO_PASSWORD=agent-password

# Web service name configured in Otobo Admin → Generic Interface
# Default: GenericTicketConnectorREST
OTOBO_WEBSERVICE=GenericTicketConnectorREST

# Set to "true" to allow self-signed or internal SSL certificates
# Only use this if your Otobo instance does not have a publicly trusted certificate
OTOBO_UNSAFE_SSL=false
